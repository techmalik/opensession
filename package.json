{
  "name": "opensession",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "seed:gen": "node scripts/gen-seed.mjs",
    "db:local": "wrangler d1 migrations apply opensession-db --local && wrangler d1 execute opensession-db --local --file=database/seed.sql",
    "db:remote": "wrangler d1 migrations apply opensession-db --remote && wrangler d1 execute opensession-db --remote --file=database/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.120.0"
  }
}
